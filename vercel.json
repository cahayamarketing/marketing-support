    {
      "source": "/api/master",
      "destination": "/api/backend?action=getMasterData"
    },
    {
      "source": "/api/salesman",
      "destination": "/api/backend?action=getSalesmen"
    },
    {
      "source": "/api/pkm",
      "destination": "/api/backend?action=getPkmData"
